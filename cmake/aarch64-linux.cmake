# Cross build for Linux AArch64 handhelds (Cortex-A53) with LLVM against a target sysroot.
# Set GC_SYSROOT, GC_CLANG, GC_CLANGXX and GC_LLD.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
foreach(required GC_SYSROOT GC_CLANG GC_CLANGXX GC_LLD)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "Set ${required} to an installed target toolchain path")
    endif()
endforeach()
set(CMAKE_SYSROOT "${GC_SYSROOT}")
set(CMAKE_C_COMPILER "${GC_CLANG}")
set(CMAKE_CXX_COMPILER "${GC_CLANGXX}")
set(CMAKE_ASM_COMPILER "${GC_CLANG}")
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET aarch64-linux-gnu)
# Cortex-A53 tuning with its multiply-accumulate (835769) and ADRP (843419) errata workarounds.
set(gc_cpu_flags "-mcpu=cortex-a53 -mfix-cortex-a53-835769")
set(CMAKE_C_FLAGS_INIT "--no-default-config --gcc-toolchain=${GC_SYSROOT}/usr ${gc_cpu_flags}")
set(CMAKE_CXX_FLAGS_INIT "--no-default-config --gcc-toolchain=${GC_SYSROOT}/usr ${gc_cpu_flags}")
set(CMAKE_ASM_FLAGS_INIT "--no-default-config --gcc-toolchain=${GC_SYSROOT}/usr ${gc_cpu_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "--ld-path=${GC_LLD} -Wl,--fix-cortex-a53-843419")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES GC_SYSROOT GC_CLANG GC_CLANGXX GC_LLD)
